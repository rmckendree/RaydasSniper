# Build artifacts (regenerated by build scripts / PyInstaller / Inno Setup)
build/
dist/
installer/Output/
*.pyc
__pycache__/

# Runtime output (created by the tool at run time) — keep the empty dirs
results/*
!results/.gitkeep
bodies/*
!bodies/.gitkeep

# Captured / sensitive request data — never commit real captures or tokens
Requests/api-capture-*.json
Requests/*.postman_environment.json
*.env
.env
*.pem
*.key
